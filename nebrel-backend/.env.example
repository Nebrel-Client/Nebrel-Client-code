# Copy to .env and fill in. Never commit the real file.
PORT=4000
HOST=127.0.0.1

# Signs the launcher token. Generate with: openssl rand -hex 48
JWT_SECRET=change-me

# How long an issued launcher token stays valid, in seconds.
TOKEN_TTL=604800

DATABASE_URL=postgres://nebrel:password@127.0.0.1:5432/nebrel
REDIS_URL=redis://127.0.0.1:6379
